{
  "product": "io-mon",
  "versionFile": "version.txt",
  "packageName": "metacraft-io-mon",
  "commands": ["io-mon"],
  "license": "Apache-2.0",
  "summary": "Filesystem and process activity monitor",
  "targets": [
    {
      "id": "linux-x86_64",
      "runner": "eph-linux-x64-release",
      "assets": [
        "{product}-{version}-linux-x86_64.tar.gz",
        "{product}-{version}-linux-x86_64.json",
        "metacraft-io-mon_{version}-1_amd64.deb",
        "metacraft-io-mon-{version}-1.x86_64.rpm"
      ]
    },
    {
      "id": "linux-aarch64",
      "runner": "ubuntu-24.04-arm",
      "assets": [
        "{product}-{version}-linux-aarch64.tar.gz",
        "{product}-{version}-linux-aarch64.json",
        "metacraft-io-mon_{version}-1_arm64.deb",
        "metacraft-io-mon-{version}-1.aarch64.rpm"
      ],
      "runnerReason": "Temporary native Linux ARM64 release migration exception while the self-hosted Tart route is unfinished.",
      "runnerMigration": {
        "version": "0.1.0",
        "owner": "zah",
        "followup": "https://github.com/metacraft-labs/metacraft-specs/blob/latest/issues/2026-09-28-release-linux-arm64-runner-migration.md"
      }
    },
    {
      "id": "darwin-aarch64",
      "runner": ["self-hosted", "macos", "arm64"],
      "assets": [
        "{product}-{version}-darwin-aarch64.tar.gz",
        "{product}-{version}-darwin-aarch64.json"
      ]
    },
    {
      "id": "windows-x86_64",
      "runner": ["self-hosted", "windows", "x64"],
      "assets": [
        "{product}-{version}-windows-x86_64.zip",
        "{product}-{version}-windows-x86_64.json"
      ]
    }
  ],
  "unsignedReleaseVersion": "0.1.0"
}
