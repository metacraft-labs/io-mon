.direnv/
nimcache/
build/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.obj
*.o
*.a
*.lib
*.exp
test-logs/

# Compiled test binaries (nim c -r leaves the binary next to its source).
# Tests live under per-OS subdirs (tests/portable, tests/posix, tests/macos,
# tests/linux, tests/windows); the binary has the same name as the .nim source
# minus the extension. Ignore the binaries, keep the sources.
tests/*/test_*
!tests/*/test_*.nim

# Reprobuild environment cache
.repro/

# Generated by the flake's git-hooks shellHook on `nix develop`; a symlink
# into the Nix store whose target changes per flake eval. Must not be tracked
# (a committed copy dangles in CI's isolated checkout). Matches reprobuild and
# codetracer. While it WAS tracked, every flake eval left it modified-but-
# unstaged, and prek refuses to run at all in that state ("prek configuration
# file is not staged") -- so this repo's hooks were silently inert and commits
# needed --no-verify.
.pre-commit-config.yaml
